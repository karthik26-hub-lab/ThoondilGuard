{
  "name": "thoondilguard-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "evaluate:dataset": "tsx scripts/evaluate-dataset.ts",
    "verify:analysis": "tsx scripts/verify-analysis.ts",
    "verify:phase4c": "tsx scripts/verify-phase4c.ts",
    "verify:phase4d": "tsx scripts/verify-phase4d.ts",
    "verify:phase5a": "tsx scripts/verify-phase5a.ts",
    "verify:phase5b": "tsx scripts/verify-phase5b.ts",
    "evaluate:gemini": "tsx scripts/evaluate-live-gemini.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "setup:local": "node scripts/setup-local.mjs",
    "reset:admin": "node scripts/reset-admin.mjs",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "test:spam": "npm run build && node scripts/test-spam.mjs"
  },
  "dependencies": {
    "@google/genai": "2.27.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.4",
    "nodemailer": "^10.0.14",
    "tesseract.js": "7.0.0",
    "tldts": "7.4.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
