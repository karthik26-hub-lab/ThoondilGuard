PORT=5000
NODE_ENV=development
# Empty for direct/local access. In production list ONLY your hosting proxy's
# documented IPs/CIDRs, comma-separated. Never use true or a hop count.
TRUSTED_PROXY_CIDRS=
CLIENT_ORIGIN=http://localhost:5173
# Dedicated admin origins; same-site HTTPS subdomains are recommended in production.
ADMIN_ORIGIN=http://localhost:4190,http://127.0.0.1:4190

# Replace these placeholders with the MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=thoondilguard
# Optional fallback when the local DNS provider blocks MongoDB Atlas SRV queries.
DNS_SERVERS=

# Optional server-side Gemini API key. Set locally to enable Gemini; blank uses deterministic rules only.
GEMINI_MODEL=
GEMINI_API_KEY=

# Optional internal/preparatory campaign intelligence API gate (minimum 32 characters; not a substitute for RBAC).
INTERNAL_THREAT_INTELLIGENCE_TOKEN=

# Optional directory containing eng.traineddata(.gz); otherwise Tesseract.js fetches it on first OCR use.
TESSERACT_LANG_PATH=

# Required for report verification, tracking keys and admin sessions. Generate a random 32+ character secret locally.
APP_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# SMS delivery via Twilio (approved account/sender and local registration requirements apply).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Email delivery via Nodemailer (e.g. Gmail App Passwords)
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
